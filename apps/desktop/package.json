{
  "name": "@shippy/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shippy desktop application.",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "pnpm typecheck && electron-vite build",
    "predev": "install-electron --no",
    "dev": "electron-vite dev",
    "prestart": "install-electron --no",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@shippy/ui": "workspace:*",
    "electron-log": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "catalog:",
    "remark-gfm": "catalog:",
    "simple-git": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@shippy/typescript-config": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "electron": "catalog:",
    "electron-vite": "catalog:",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
